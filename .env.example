# متغيرات البيئة المطلوبة للدفع — أضف القيم من لوحة Netlify:
# Project configuration → Environment variables (وحدد كل مفتاح كـ Secret).
# لا تضع القيم الحقيقية في هذا الملف.

# Paymob — مصر (EGP)
# (مقبول أيضاً: PAYMOB_PUBLIC_KEY / PAYMOB_SECRET_KEY / PAYMOB_HMAC_SECRET / PAYMOB_INTEGRATION_IDS / PAYMOB_IFRAME_ID)
# صفحة الدفع الموحدة (Intention API)
PAYMOB_EGP_PUBLIC_KEY=
PAYMOB_EGP_SECRET_KEY=
# API Key القديم + iframe: يُستخدم تلقائياً إذا لم تكن Intention مفعّلة على الحساب
PAYMOB_API_KEY=
# اختياري: رقم الـ iframe من Developers → iframes (إن تُرك فارغاً يُستخدم أول iframe في الحساب)
PAYMOB_EGP_IFRAME_ID=
PAYMOB_EGP_HMAC_SECRET=
# رقم/أرقام Integration ID من Paymob → Developers → Payment Integrations (مفصولة بفواصل)
PAYMOB_EGP_INTEGRATION_IDS=

# Paymob — السعودية (SAR) — اختياري، يحتاج حساب Paymob سعودي
PAYMOB_SAR_PUBLIC_KEY=
PAYMOB_SAR_SECRET_KEY=
PAYMOB_SAR_HMAC_SECRET=
PAYMOB_SAR_INTEGRATION_IDS=
